# Copy to .env and fill in. Never commit the filled file.

NODE_ENV=development
PORT=4000

# Comma-separated allowlist of browser origins permitted to call this API.
FRONTEND_URL=http://localhost:3000

# MongoDB Atlas connection string, including the database user's password.
MONGODB_URI=
MONGODB_DB=personal_ledger

# The Firebase project whose ID tokens this API accepts.
# NOTE: no service-account private key is required. Tokens are verified against
# Google's published public certificates — see src/shared/auth/verify-token.ts.
FIREBASE_PROJECT_ID=

# Receipt OCR. Optional: without one, the scan endpoint reports itself
# unavailable and the app falls back to manual entry.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
